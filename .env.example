# Скопируйте в .env (или передайте через `docker run --env-file`/`-e`) и поменяйте по необходимости.
# Все переменные опциональны — сервис стартует с дефолтами, указанными ниже.

# Каталог с ONNX-артефактами (vision.onnx, lm.onnx, embed_tokens.npy, head.npz, meta.json, tokenizer.json).
# Не лежит в git (см. README/.gitignore) — положите его на машину перед запуском.
ARTIFACTS_DIR=artifacts/smolvlm_int8

# Общий бюджет на запрос в секундах (включая ожидание в очереди). После истечения — 504.
TIMEOUT_S=10
# Запас на сериализацию ответа/сеть, вычитается из TIMEOUT_S при расчёте дедлайна инференса.
SAFETY_MARGIN_S=0.4

# Лимиты на вход
MAX_IMAGES=4
MAX_IMAGE_BYTES=8388608
MAX_TEXT_CHARS=4000
MAX_TEXT_TOKENS=512

# Сколько запросов могут ждать в очереди, пока идёт расчёт текущего (расчёт всегда строго один за раз)
MAX_QUEUE=2

# intra_op_num_threads ONNX Runtime — держите в 1 на 1 CPU
ORT_THREADS=1
# Прогреть модель фиктивным запросом при старте (чтобы первый реальный запрос не съел бюджет)
WARMUP=1

# Пороги срабатывания по категориям (0..1)
THR_DANGEROUS=0.75
THR_SPAM=0.5
THR_JUNK=0.5
THR_MISMATCH=0.5
